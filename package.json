{
  "name": "vigie",
  "productName": "Vigie",
  "version": "1.0.0",
  "description": "Vigie - surveillance maison pour cameras Wyze",
  "author": "NStudio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ca.nstudio.vigie",
    "productName": "Vigie",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "server/**/*",
      "node_modules/**/*",
      "updater.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vigie"
    },
    "publish": {
      "provider": "github",
      "owner": "PHENllX",
      "repo": "vigie",
      "releaseType": "release"
    }
  }
}